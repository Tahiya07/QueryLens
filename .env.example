# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QUERYLENS_SECRET_KEY=replace-with-a-random-secret-before-running
# Leave empty for SQLite, or configure PostgreSQL, for example:
# QUERYLENS_DATABASE_URL=postgresql+psycopg://querylens:password@localhost:5432/querylens
QUERYLENS_DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-postgres-password
